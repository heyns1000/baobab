# =============================================================================
# 🌳 BAOBAB SECURITY NETWORK™ — ENVIRONMENT VARIABLES
# Fruitful Holdings (Pty) Ltd | FAA-ACT-2026-X99 | Gorilla Comb™ VaultMesh L7
# Copy this file to .env and replace all YOUR_*_HERE values before running.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=baobab-security-network
APP_URL=https://YOUR_APP_URL_HERE
APP_PORT=3000
APP_SECRET=YOUR_APP_SECRET_HERE

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID_HERE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD_HERE@db.YOUR_SUPABASE_PROJECT_ID_HERE.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# GITHUB
# -----------------------------------------------------------------------------
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET_HERE
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET_HERE
GITHUB_OWNER=heyns1000
GITHUB_REPO=baobab

# -----------------------------------------------------------------------------
# VERCEL
# -----------------------------------------------------------------------------
VERCEL_TOKEN=YOUR_VERCEL_TOKEN_HERE
VERCEL_ORG_ID=YOUR_VERCEL_ORG_ID_HERE
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID_HERE

# -----------------------------------------------------------------------------
# CLOUDFLARE
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID_HERE
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth / Auth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://YOUR_APP_URL_HERE
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE

# -----------------------------------------------------------------------------
# EMAIL (SMTP / Resend / SendGrid)
# -----------------------------------------------------------------------------
SMTP_HOST=YOUR_SMTP_HOST_HERE
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM=noreply@YOUR_DOMAIN_HERE
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
COHERE_API_KEY=YOUR_COHERE_API_KEY_HERE

# -----------------------------------------------------------------------------
# MAPS / GEOLOCATION
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=YOUR_GA_MEASUREMENT_ID_HERE
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
POSTHOG_API_KEY=YOUR_POSTHOG_API_KEY_HERE
POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# STORAGE (S3 / R2 / Supabase Storage)
# -----------------------------------------------------------------------------
S3_BUCKET=YOUR_S3_BUCKET_NAME_HERE
S3_REGION=YOUR_S3_REGION_HERE
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE
S3_ENDPOINT=YOUR_S3_ENDPOINT_HERE
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
CLOUDFLARE_R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
CLOUDFLARE_R2_BUCKET=YOUR_R2_BUCKET_NAME_HERE

# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=YOUR_STRIPE_PUBLIC_KEY_HERE
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
PAYFAST_MERCHANT_ID=YOUR_PAYFAST_MERCHANT_ID_HERE
PAYFAST_MERCHANT_KEY=YOUR_PAYFAST_MERCHANT_KEY_HERE
PAYFAST_PASSPHRASE=YOUR_PAYFAST_PASSPHRASE_HERE

# -----------------------------------------------------------------------------
# MESSAGING / WEBHOOKS
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN_HERE
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
WHATSAPP_API_KEY=YOUR_WHATSAPP_API_KEY_HERE

# -----------------------------------------------------------------------------
# FRUITFUL ECOSYSTEM INTERNAL
# -----------------------------------------------------------------------------
FRUITFUL_API_KEY=YOUR_FRUITFUL_API_KEY_HERE
FRUITFUL_VAULT_TOKEN=YOUR_FRUITFUL_VAULT_TOKEN_HERE
OMNIGRID_API_KEY=YOUR_OMNIGRID_API_KEY_HERE
CODENEST_TOKEN=YOUR_CODENEST_TOKEN_HERE
MR_ACTUARY_API_KEY=YOUR_MR_ACTUARY_API_KEY_HERE
GHOSTTRACE_SECRET=YOUR_GHOSTTRACE_SECRET_HERE
VAULTMESH_L7_KEY=YOUR_VAULTMESH_L7_KEY_HERE

# -----------------------------------------------------------------------------
# DATABASE (additional / Redis / PlanetScale)
# -----------------------------------------------------------------------------
DATABASE_URL=YOUR_DATABASE_URL_HERE
REDIS_URL=YOUR_REDIS_URL_HERE
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
PLANETSCALE_DATABASE_URL=YOUR_PLANETSCALE_URL_HERE

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_DEBUG=false
ENABLE_MAINTENANCE_MODE=false
ENABLE_BETA_FEATURES=false
